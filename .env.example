# Optional: set STYREROMMET_ENV_PATH to this file's absolute path to use it.
# Default: platform application-data directory/styrerommet-mcp/.env.
# Interactive login creates the file automatically; no copy is needed.
# Identifiers are detected after sign-in. Set only as fallbacks.
STYREROMMET_ORG_ID=
VIBBO_ORG_SLUG=

# Populated by styrerommet-mcp --auth. Treat these values as passwords.
STYREROMMET_COOKIE=
STYREROMMET_ARKIV_TOKEN=
STYREROMMET_ARKIV_COOKIE=
VIBBO_COOKIE=
MITTBYGG_COOKIE=

# Optional overrides (set these in the launching process's environment).
# STYREROMMET_ENV_PATH=/absolute/path/to/private/.env
# STYREROMMET_AUTH_PROFILE_DIR=/absolute/path/to/private/auth-profile
# STYREROMMET_BROWSER_EXECUTABLE=/absolute/path/to/browser
# STYREROMMET_BROWSER_CHANNEL=chrome
# NO_AUTO_LOGIN=true
